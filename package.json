{
"name": "h5p-interactive-book-papijo",
"version": "1.14.3",
  "private": true,
  "description": "An interactive book which displays content in pages and sections. A papijo version",
  "scripts": {
    "test": "node --test tests/runtime/*.test.cjs",
    "dev": "cross-env NODE_ENV='development' webpack",
    "build": "cross-env NODE_ENV='production' webpack",
    "watch": "webpack --watch",
    "lint:js": "eslint src/**/*.js",
    "verify:production": "node tools/verify-production-immutability.cjs",
    "verify:release": "node tools/verify-release-metadata.cjs",
    "verify": "npm run verify:production && npm run verify:release && npm test",
    "package:release": "pwsh -NoProfile -File tools/build-release-package.ps1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rezeau/h5p-interactive-book-papijo"
  },
  "keywords": [
    "h5p",
    "library"
  ],
  "author": "Joubel",
  "license": "MIT",
  "devDependencies": {
    "cross-env": "^7.0.3",
    "css-loader": "^6.7.1",
    "eslint": "^8.18.0",
    "mini-css-extract-plugin": "^2.6.1",
    "sass": "^1.53.0",
    "sass-loader": "^13.0.2",
    "webpack": "^5.76.0",
    "webpack-cli": "^4.10.0"
  },
  "dependencies": {
    "color": "^4.2.3",
    "jquery-circle-progress": "^1.2.2",
    "tinycolor2": "^1.6.0"
  }
}
